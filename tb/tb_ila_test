module tb_ila_test(

    );

reg clk_in_50M;
reg start_key;
reg hsync;
reg [3:0]   data;
reg         en;


wire [11:0] dac_data1;
wire  dac_clk1;
wire     pulse_16ms_1ms;
wire     clk_2_5M;
wire     clk_200K;

initial begin
    clk_in_50M =1'b0;
    start_key  =1'b1;
   
    hsync      =1'b1;
    data       =4'b1111;
    en         =1'b1;


#20000
    start_key  =1'b0;
   
#20000
    start_key  =1'b1;


end

always #10 clk_in_50M=~clk_in_50M;

reg clk_125M = 0;
always #4 clk_125M = ~clk_125M; // 125MHz

reg clk_5M = 0;
always #100 clk_5M = ~clk_5M; // 5MHz

ila_test ila_test_inst(
            .clk_in_50M    ( clk_in_50M ) ,
            .start_key     ( start_key  ) ,
            .hsync         ( hsync      ) ,
            .data          ( data       ) ,
            .en            ( en         ) ,
            .clk_2_5M      ( clk_2_5M   ) ,
            .clk_200K      ( clk_200K   ) ,
            

            .dac_clk1      ( dac_clk1     ),
            .dac_data1     ( dac_data1    ),
            .pulse_16ms_1ms( pulse_16ms_1ms  )
    );








endmodule
